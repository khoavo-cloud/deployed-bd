# Notion internal integration token — https://www.notion.so/my-integrations
# Share BOTH databases with the integration (••• → Connections → your integration)
NOTION_TOKEN=ntn_xxxxxxxxxxxx

# 32-char ids from each database URL: notion.so/<workspace>/<DB_ID>?v=...
NOTION_SOURCE_DB_ID=
NOTION_TARGET_DB_ID=

# Google AI Studio API key — https://aistudio.google.com/apikey
# On the free tier Google may use prompts and responses (with human review) to
# improve its models, and these prompts carry lead names, emails and companies.
# Link billing to opt out of that.
GOOGLE_API_KEY=

# Optional. Free tier is Flash-only since April 2026; point research at a Pro
# model once billing is on — that is the call where model quality shows.
# GEMINI_RESEARCH_MODEL=gemini-3.6-flash
# GEMINI_STRUCTURE_MODEL=gemini-3.6-flash

# Basic auth for the deployed UI. Required — the app refuses to serve without it.
BD_USER=bd
BD_PASSWORD=
